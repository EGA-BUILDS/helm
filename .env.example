# Helm - environment configuration (placeholders only; never commit real values)
#
# Copy to .env.local for local development:  cp .env.example .env.local
# `.env*` is gitignored. Production values belong in the Convex dashboard
# (Convex environment settings) and/or the Vercel project environment - never
# in this repository, a Linear comment, a log, or a browser bundle.
#
# Naming below reflects the variables the current EGA-677 adapter code reads.
# A variable is only real once the corresponding adapter reads it AND the owner
# has supplied a value; see doc/configuration-checklist.md.

# ---------------------------------------------------------------------------
# Frontend (Next.js, build-time; NEXT_PUBLIC_* is inlined into the browser bundle)
# ---------------------------------------------------------------------------
# Public URL of the Convex deployment the browser subscribes to. Must be the
# deployment the app is intended to use. Never point Vercel production at the
# personal development backend as a build shortcut.
NEXT_PUBLIC_CONVEX_URL=https://YOUR_CONVEX_DEPLOYMENT_URL

# Public Convex site/dashboard URL, shown for diagnostics only.
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR_CONVEX_SITE_URL

# ---------------------------------------------------------------------------
# Convex CLI (local development only; not needed by the deployed app)
# ---------------------------------------------------------------------------
# Deployment selector used by `npx convex dev`. Accepts a bare deployment name
# for a hosted deployment (for example "dev:YOUR_DEPLOYMENT_NAME").
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT_NAME

# ---------------------------------------------------------------------------
# Server-side integration credentials (Convex environment settings ONLY)
#
# These are read by Convex server functions. They must never be prefixed with
# NEXT_PUBLIC_ and must never be referenced from a Client Component.
# ---------------------------------------------------------------------------

# T3 Code MCP endpoint (RFC 9728 protected-resource URL). Required for EGA-677
# hosted discovery. Must be reachable from the hosted Convex runtime.
# PRIVILEGED DISCOVERY ONLY: this endpoint is never used for dispatch and is
# never a fallback for the isolated pair below.
T3_MCP_URL=https://YOUR_PUBLIC_T3_MCP_ENDPOINT/mcp

# Bearer credential for the T3 MCP endpoint, issued by `t3 auth session issue`.
# Stored as a Convex environment variable; never logged, never returned by a
# query, never sent to the browser. PRIVILEGED DISCOVERY ONLY.
T3_MCP_TOKEN=

# ISOLATED T3 MCP endpoint that dispatch is allowed to launch on (EGA-677).
# Dispatch reads ONLY this URL; there is no fallback to T3_MCP_URL. Must be a
# valid absolute https URL with no embedded userinfo. Missing or invalid means
# dispatch is disabled entirely (fail closed).
T3_MCP_URL_ISOLATED=https://YOUR_ISOLATED_T3_MCP_ENDPOINT/mcp

# ISOLATED T3 MCP bearer credential. Dispatch reads ONLY this token; there is
# no fallback to T3_MCP_TOKEN. Missing means dispatch is disabled (fail closed).
T3_MCP_TOKEN_ISOLATED=

# Trusted isolated T3 project binding. Dispatch is disabled unless callers
# name exactly this project; this is not the Linear project UUID below.
T3_PROJECT_ID_ISOLATED=

# Linear personal API key, server-side only, minimum read scope. See
# https://developers.linear.app/docs/graphql/working-with-the-graphql-api
LINEAR_API_KEY=

# Linear project UUID (Settings > Projects in Linear). Target project for F3.
LINEAR_PROJECT_ID=

# ---------------------------------------------------------------------------
# Owner identity (EGA-678)
# ---------------------------------------------------------------------------
# Clerk publishable key for the browser (ClerkProvider + sign-in UI) and the
# secret key for server-side session verification. Placeholders only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL (JWT issuer) for Convex DEV authentication.
CLERK_FRONTEND_API_URL=

# The single immutable owner identity allowed to read private data or dispatch.
# Bind to the authenticated identity server-side; never accept this from a client.
HELM_OWNER_SUBJECT=
