# Helm - environment configuration (placeholders only; never commit real values)
#
# Copy to .env.local for local development:  cp .env.example .env.local
# `.env*` is gitignored. Production values belong in the Convex dashboard
# (Convex environment settings) and/or the Vercel project environment - never
# in this repository, a Linear comment, a log, or a browser bundle.
#
# Naming below reflects the variables the current EGA-677 adapter code reads.
# A variable is only real once the corresponding adapter reads it AND the owner
# has supplied a value; see doc/configuration-checklist.md.

# ---------------------------------------------------------------------------
# Frontend (Next.js, build-time; NEXT_PUBLIC_* is inlined into the browser bundle)
# ---------------------------------------------------------------------------
# Public URL of the Convex deployment the browser subscribes to. Must be the
# deployment the app is intended to use. Never point Vercel production at the
# personal development backend as a build shortcut.
NEXT_PUBLIC_CONVEX_URL=https://YOUR_CONVEX_DEPLOYMENT_URL

# Public Convex site/dashboard URL, shown for diagnostics only.
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR_CONVEX_SITE_URL

# Optional: enable fixture data in the T3 workspace (development only).
NEXT_PUBLIC_HELM_T3_FIXTURES=false

# ---------------------------------------------------------------------------
# Convex CLI (local development only; not needed by the deployed app)
# ---------------------------------------------------------------------------
# Deployment selector used by `npx convex dev`. Accepts a bare deployment name
# for a hosted deployment (for example "dev:YOUR_DEPLOYMENT_NAME").
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT_NAME

# ---------------------------------------------------------------------------
# Native T3 Connect OAuth configuration
#
# HELM_APP_URL IS REQUIRED IN BOTH RUNTIMES. It answers two different questions
# and the browser cannot complete a Connect or Reconnect unless both agree:
#
#   Vercel / Next.js  -> the origin of THIS deployment. `requireSameOrigin`
#                        compares the request `Origin` header against it for
#                        every mutating route (Connect, Reconnect, Refresh,
#                        Disconnect), and it is the post-callback redirect
#                        target. A mismatch fails CLOSED as `origin_mismatch`,
#                        so reads keep working while every mutation is refused.
#   Convex DEV        -> the OAuth `redirect_uri` registered with T3. It must be
#                        the same origin, or T3 returns the browser to a
#                        different deployment than the one that started.
#
# Vercel preview deployments get their own origin per branch. Set this variable
# for the specific Preview branch as well as Production, and redeploy after
# changing it — the value is read at build time. Because Convex DEV is shared by
# every Vercel preview of this project, changing the Convex value moves the
# callback origin for ALL of them at once; only one preview can complete OAuth
# at a time. See doc/integrations/EGA-679-native-t3-backend.md.
#
# Example preview origin:
#   https://helm-git-<branch>-<team>.vercel.app
HELM_APP_URL=
# Active version selects a retained 32-byte base64 key. Keep old version keys
# configured until all ciphertext encrypted with them has been re-encrypted.
T3_OAUTH_ENCRYPTION_KEY_VERSION=v1
T3_OAUTH_ENCRYPTION_KEY_V1=
# Legacy v1 fallback for existing deployments; remove after key migration.
T3_OAUTH_ENCRYPTION_KEY=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Native Linear OAuth configuration (EGA-759)
#
# Linear has no dynamic client registration: the public client id below is
# required, and OAuth fails CLOSED with "Linear OAuth is not configured" when
# it is absent. The client secret is optional (public clients have none).
# Callback route path is /api/linear/callback, built from HELM_APP_URL above.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Separate encryption namespace from T3 (never reuse the T3 key vars). Active
# version selects a retained 32-byte base64 key. Keep old version keys
# configured until all ciphertext encrypted with them has been re-encrypted.
LINEAR_OAUTH_ENCRYPTION_KEY_VERSION=v1
LINEAR_OAUTH_ENCRYPTION_KEY_V1=
# Legacy v1 fallback for existing deployments; remove after key migration.
LINEAR_OAUTH_ENCRYPTION_KEY=
# ---------------------------------------------------------------------------

# T3 Code MCP endpoint (RFC 9728 protected-resource URL). Required for EGA-677
# hosted discovery. Must be reachable from the hosted Convex runtime.
# PRIVILEGED DISCOVERY ONLY: this endpoint is never used for dispatch and is
# never a fallback for the isolated pair below.
T3_MCP_URL=https://YOUR_PUBLIC_T3_MCP_ENDPOINT/mcp

# Bearer credential for the T3 MCP endpoint, issued by `t3 auth session issue`.
# Stored as a Convex environment variable; never logged, never returned by a
# query, never sent to the browser. PRIVILEGED DISCOVERY ONLY.
T3_MCP_TOKEN=

# ISOLATED T3 MCP endpoint that dispatch is allowed to launch on (EGA-677).
# Dispatch reads ONLY this URL; there is no fallback to T3_MCP_URL. Must be a
# valid absolute https URL with no embedded userinfo. Missing or invalid means
# dispatch is disabled entirely (fail closed).
T3_MCP_URL_ISOLATED=https://YOUR_ISOLATED_T3_MCP_ENDPOINT/mcp

# ISOLATED T3 MCP bearer credential. Dispatch reads ONLY this token; there is
# no fallback to T3_MCP_TOKEN. Missing means dispatch is disabled (fail closed).
T3_MCP_TOKEN_ISOLATED=

# Trusted isolated T3 project binding. Dispatch is disabled unless callers
# name exactly this project; this is not the Linear project UUID below.
T3_PROJECT_ID_ISOLATED=

# Native T3 write target (v0.2 write-safety gate). These apply to the OWNER
# OAuth native write paths (launch, follow-up send, interrupt), NOT to the
# isolated dispatch pair above. Both are REQUIRED and fail closed: if either is
# missing or malformed, every native write is refused before any network call.
# Set them only to the disposable T3 instance the owner has approved for
# writes. The endpoint must be the exact stored connection endpoint.
T3_NATIVE_WRITE_ENDPOINT=https://YOUR_APPROVED_T3_MCP_ENDPOINT/mcp

# Comma-separated T3 environment ids approved for native writes, taken from
# `t3_environment_read` on the approved instance (never from a UI label).
T3_NATIVE_WRITE_ENVIRONMENTS=

# Linear personal API key, server-side only, minimum read scope. See
# https://developers.linear.app/docs/graphql/working-with-the-graphql-api
LINEAR_API_KEY=

# Linear project UUID (Settings > Projects in Linear). Target project for F3.
LINEAR_PROJECT_ID=

# ---------------------------------------------------------------------------
# GitHub read-only verification (EGA-766)
#
# Helm NEVER writes to GitHub: no push, no branch, no pull request, no merge.
# The only GitHub capability Helm needs is ONE read per verification attempt:
# `GET /repos/{owner}/{repo}/pulls/{number}`.
#
# GITHUB_TOKEN must be a READ-ONLY credential:
#   - fine-grained personal access token with "Pull requests: read" on the
#     target repositories (preferred, least privilege); or
#   - classic PAT with `public_repo` (public repositories only).
# NEVER grant `contents: write`, `pull_requests: write` or `workflow`.
#
# ABSENT TOKEN => pull-request state is reported as `verification_unavailable`.
# Helm never falls back to a guess, an agent's word, or an unauthenticated
# read. The token is read only inside the Convex action, travels only in the
# Authorization header of the read-only requests, and is never logged or
# stored. Helm reads the pull request and, best effort, its reviews; nothing
# else. A review decision is only ever reported from those reviews, never
# invented.
GITHUB_TOKEN=
#
# Optional operator-configured repository identity, as `owner/name` (e.g.
# `EGA-BUILDS/helm`). When it is set it is AUTHORITATIVE: T3's own project
# record must agree with it, or nothing is verified at all. When it is absent,
# T3's record is used instead and the owner is told the identity was asserted
# by T3 rather than independently configured.
HELM_GITHUB_REPOSITORY=
#
# Optional operator-configured target branch (e.g. `develop`). When it is set,
# the verified pull request must target exactly that branch. Without it the
# target branch is still checked against the branch the claim reports and
# against the branch GitHub reports.
HELM_GITHUB_BASE_BRANCH=

# ---------------------------------------------------------------------------
# Owner identity (EGA-678)
# ---------------------------------------------------------------------------
# Clerk publishable key for the browser (ClerkProvider + sign-in UI) and the
# secret key for server-side session verification. Placeholders only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL (JWT issuer) for Convex DEV authentication.
CLERK_FRONTEND_API_URL=

# The single immutable owner identity allowed to read private data or dispatch.
# Bind to the authenticated identity server-side; never accept this from a client.
HELM_OWNER_SUBJECT=
